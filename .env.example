# =============================================================================
# VERA environment variables — copy to `.env` (repo root) and fill in values.
# `.env` is gitignored. NEVER commit real secrets.
# =============================================================================

# === DATABASE ================================================================
# OPTION A (default) — Supabase.
#   Use the *Session pooler* string (Project Settings -> Database -> Connection
#   string -> "Session pooler"). The direct `db.<ref>.supabase.co` host is
#   IPv6-only and unreachable from Render / many home networks.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# OPTION B — local Docker (`docker compose up -d`):
# DATABASE_URL=postgresql://vera:vera@localhost:5432/vera

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# === REDIS ===================================================================
# OPTION A (default) — Upstash. Must be `rediss://` (TLS). VERA appends
# `ssl_cert_reqs=required` automatically if it is missing.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
#
# OPTION B — local Docker:
# REDIS_URL=redis://localhost:6379/0

# Leave blank to reuse REDIS_URL (the usual setup).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# === LABEL GENERATION (notebooks only) =======================================
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_key

# === HUGGINGFACE =============================================================
HF_TOKEN=hf_your_token_here
# Repo holding the production artifacts listed in backend/app/ml/models/loader.py
HF_MODEL_REPO=YOUR_HF_USERNAME/vera-models
# Where artifacts live locally. Relative paths resolve against the repo root.
MODEL_DIR=data/models

# === APP =====================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_64_char_hex_string
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# === FRONTEND (frontend/.env.local) ==========================================
# NEXT_PUBLIC_API_URL=http://localhost:8000
